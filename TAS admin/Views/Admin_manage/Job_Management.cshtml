@model TAS_admin.Models.JobManagementViewModel
@{
    ViewBag.Title = "Admin_manage";
}

<h2>มอบหมายงานขนส่ง</h2>
<br />
<hr />

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@using (Html.BeginForm("Job_Management", "Admin_manage", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Shipment.ShipmentId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <h3>ข้อมูลงานขนส่ง</h3>
    <br />
    <div class="row">
        <div class="container">
            <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.Shipment.ShipmentNo, "Shipment No")
                @Html.TextBoxFor(m => m.Shipment.ShipmentNo, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Shipment.ShipmentNo, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.Shipment.Status, "Status")
                @Html.TextBoxFor(m => m.Shipment.Status, new { @class = "form-control" })
            </div>
            <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.Shipment.DeliveryDate, "Delivery Date")
                @Html.TextBoxFor(m => m.Shipment.DeliveryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.Shipment.DriverId, "Driver")
                @Html.DropDownListFor(m => m.Shipment.DriverId, Model.DriverList, "-- เลือกคนขับ --", new { @class = "form-control" })
            </div>
            <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.Shipment.TruckId, "Truck No")
                @Html.DropDownListFor(m => m.Shipment.TruckId, Model.TruckList, "-- เลือกรถ --", new { @class = "form-control" })
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="container">
            <div class="col-lg-4"></div>
            <div class="col-lg-4">
                <input type="submit" class="btn btn-default" value="ตกลง" />
                @Html.ActionLink("ยกเลิก", "Job_Management", null, new { @class = "btn btn-default" })
            </div>
            <div class="col-lg-4"></div>
        </div>
    </div>
}

@if (Model.Shipment.ShipmentId > 0)
{
    <hr />
    <h3>Delivery Orders (Shipment: @Model.Shipment.ShipmentNo)</h3>

    <div class="alert alert-info">
        ลิงก์ให้ลูกค้าติดตามพัสดุ (ไม่ต้อง login):<br />
        <a href="@Url.Action("TrackShipment", "Admin_manage", new { token = Model.Shipment.TrackingToken }, Request.Url.Scheme)" target="_blank">
            @Url.Action("TrackShipment", "Admin_manage", new { token = Model.Shipment.TrackingToken }, Request.Url.Scheme)
        </a>
    </div>
    <br />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Delivery No</th>
                <th>Order No</th>
                <th>DueDate</th>
                <th>Loading Station</th>
                <th>Destination</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in Model.DeliveryOrders)
        {
            <tr>
                <td>@order.DeliveryNo</td>
                <td>@order.OrderNo</td>
                <td>@(order.DueDate.HasValue ? order.DueDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                <td>@order.LoadingStation</td>
                <td>@order.Destination</td>
            </tr>
        }
        </tbody>
    </table>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    @using (Html.BeginForm("AddDeliveryOrder", "Admin_manage", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("ShipmentId", Model.Shipment.ShipmentId)
        <div class="row">
            <div class="container">
                <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                    <label>Delivery No : </label>
                    <input type="text" name="DeliveryNo" class="form-control" />
                </div>
                <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                    <label>Order No : </label>
                    <input type="text" name="OrderNo" class="form-control" />
                </div>
                <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                    <label>DueDate : </label>
                    <input type="date" name="DueDate" class="form-control" />
                </div>
                <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                    <label>Loading Station : </label>
                    <input type="text" name="LoadingStation" class="form-control" placeholder="เช่น แหลมฉบัง, สนามบินอู่ตะเภา" />
                </div>
                <div class="col-md-6 col-md-push-1" style="margin-top:10px;margin-bottom:10px;">
                    <label>Destination : </label>
                    <input type="text" name="Destination" class="form-control" placeholder="เช่น BigC, Hitachi ระยอง, อมตะนคร" />
                </div>
                <div class="col-md-12" style="margin-top:10px;margin-bottom:10px;">
                    <label>พิกัดปลายทาง (คลิกบนแผนที่เพื่อระบุ - ใช้คำนวณ ETA ให้ลูกค้า):</label>
                    <div id="destPickMap" style="width:100%; height:300px;"></div>
                    <input type="hidden" name="DestinationLat" id="inpDestLat" />
                    <input type="hidden" name="DestinationLng" id="inpDestLng" />
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="container">
                <input type="submit" class="btn btn-default" value="+ เพิ่ม Delivery Order" />
            </div>
        </div>
    }

    <script>
        var destPickMap = L.map('destPickMap').setView([13.7563, 100.5018], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(destPickMap);
        var destMarker = null;
        destPickMap.on('click', function (e) {
            document.getElementById('inpDestLat').value = e.latlng.lat.toFixed(6);
            document.getElementById('inpDestLng').value = e.latlng.lng.toFixed(6);
            if (destMarker) {
                destMarker.setLatLng(e.latlng);
            } else {
                destMarker = L.marker(e.latlng).addTo(destPickMap);
            }
        });
    </script>
}
