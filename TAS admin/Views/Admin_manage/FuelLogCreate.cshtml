@model TAS_admin.Models.FuelLog
@{
    ViewBag.Title = "FuelLogCreate";
}
<h2>บันทึกการเติมน้ำมัน</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.TruckId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        @Html.LabelFor(m => m.FilledAt)
        @Html.TextBoxFor(m => m.FilledAt, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Liters)
        @Html.TextBoxFor(m => m.Liters, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Cost)
        @Html.TextBoxFor(m => m.Cost, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.OdometerKm)
        @Html.TextBoxFor(m => m.OdometerKm, new { @class = "form-control" })
    </div>
    <input type="submit" class="btn btn-default" value="บันทึก" />
    @Html.ActionLink("ยกเลิก", "FuelLogList", new { truckId = Model.TruckId }, new { @class = "btn btn-default" })
}
