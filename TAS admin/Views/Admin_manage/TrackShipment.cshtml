@model TAS_admin.Models.Shipment
@{
    ViewBag.Title = "TrackShipment";
    Layout = null;
    var order = (TAS_admin.Models.DeliveryOrder)ViewBag.DeliveryOrder;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ติดตามพัสดุ @Model.ShipmentNo</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        body { font-family: Tahoma, Arial, sans-serif; margin: 0; padding: 15px; }
        h2 { margin-top: 0; }
        #info { background: #f5f5f5; border-radius: 8px; padding: 12px; margin-bottom: 10px; }
        #trackMap { width: 100%; height: 450px; border-radius: 8px; }
    </style>
</head>
<body>
    <h2>ติดตามพัสดุ: @Model.ShipmentNo</h2>
    <div id="info">
        <p>สถานะ: <b>@Model.Status</b></p>
        <p>คนขับ: @(Model.Driver != null ? Model.Driver.FullName : "-")</p>
        <p>ทะเบียนรถ: @(Model.Truck != null ? Model.Truck.LicensePlate : "-")</p>
        <p>ปลายทาง: @(order != null ? order.Destination : "-")</p>
        <p id="etaText">กำลังคำนวณเวลาถึง...</p>
    </div>
    <div id="trackMap"></div>

    <script>
        var token = "@Model.TrackingToken";
        var destLat = @(order != null && order.DestinationLat.HasValue ? order.DestinationLat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        var destLng = @(order != null && order.DestinationLng.HasValue ? order.DestinationLng.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");

        var map = L.map('trackMap').setView([13.7563, 100.5018], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var truckMarker = null;
        var destMarker = null;
        var routeLine = null;

        if (destLat !== null && destLng !== null) {
            destMarker = L.marker([destLat, destLng], { title: 'ปลายทาง' }).addTo(map).bindPopup('ปลายทาง');
        }

        function drawRoute(truckLat, truckLng) {
            if (destLat === null || destLng === null) {
                document.getElementById('etaText').innerText = 'ยังไม่ได้ระบุพิกัดปลายทางของงานนี้';
                return;
            }
            var url = 'https://router.project-osrm.org/route/v1/driving/' +
                truckLng + ',' + truckLat + ';' + destLng + ',' + destLat +
                '?overview=full&geometries=geojson';
            fetch(url)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.routes || data.routes.length === 0) {
                        document.getElementById('etaText').innerText = 'คำนวณเส้นทางไม่สำเร็จ';
                        return;
                    }
                    var route = data.routes[0];
                    var minutes = Math.round(route.duration / 60);
                    var km = (route.distance / 1000).toFixed(1);
                    document.getElementById('etaText').innerText =
                        'ระยะทางเหลือ ' + km + ' กม. ถึงปลายทางในประมาณ ' + minutes + ' นาที';

                    var coords = route.geometry.coordinates.map(function (c) { return [c[1], c[0]]; });
                    if (routeLine) {
                        map.removeLayer(routeLine);
                    }
                    routeLine = L.polyline(coords, { color: 'blue' }).addTo(map);
                    map.fitBounds(routeLine.getBounds());
                })
                .catch(function () {
                    document.getElementById('etaText').innerText = 'ไม่สามารถคำนวณเส้นทางได้ในขณะนี้';
                });
        }

        function refreshTruckLocation() {
            fetch('/Admin_manage/TrackShipmentLocation?token=' + token)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.ok) {
                        document.getElementById('etaText').innerText = 'ยังไม่มีข้อมูลตำแหน่งรถ';
                        return;
                    }
                    if (truckMarker) {
                        truckMarker.setLatLng([data.lat, data.lng]);
                    } else {
                        truckMarker = L.marker([data.lat, data.lng], { title: 'รถขนส่ง' }).addTo(map).bindPopup('รถขนส่ง');
                        map.setView([data.lat, data.lng], 12);
                    }
                    drawRoute(data.lat, data.lng);
                });
        }

        refreshTruckLocation();
        setInterval(refreshTruckLocation, 15000);
    </script>
</body>
</html>
