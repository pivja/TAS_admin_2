@model IEnumerable<TAS_admin.Models.Shipment>
@{
    ViewBag.Title = "History";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">

<h2>ประวัติงานขนส่ง</h2>
<br />

<table class="table table-striped">
    <thead>
        <tr>
            <th>Shipment No</th>
            <th>สถานะ</th>
            <th>วันที่ส่ง</th>
            <th>คนขับ</th>
            <th>ทะเบียนรถ</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.ShipmentNo</td>
            <td>@s.Status</td>
            <td>@(s.DeliveryDate.HasValue ? s.DeliveryDate.Value.ToString("dd/MM/yyyy") : "-")</td>
            <td>@(s.Driver != null ? s.Driver.FullName : "-")</td>
            <td>@(s.Truck != null ? s.Truck.LicensePlate : "-")</td>
            <td>@Html.ActionLink("ดูรายละเอียด", "History_id", new { id = s.ShipmentId }, new { @class = "btn btn-sm btn-default" })</td>
        </tr>
    }
    </tbody>
</table>
