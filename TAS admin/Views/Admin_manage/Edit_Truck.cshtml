@model TAS_admin.Models.TruckDriverViewModel
@{
    ViewBag.Title = "Edit_Truck";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">

<h2>@(Model.TruckId > 0 ? "แก้ไขข้อมูลรถ/คนขับ" : "เพิ่มรถ/คนขับใหม่")</h2>
<br />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.TruckId)
    @Html.HiddenFor(m => m.DriverId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="row">
        <div class="container">
            <h3>ข้อมูลคนขับรถ</h3>
            <div class="col-md-6" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.FullName)
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.LicenseNo)
                @Html.TextBoxFor(m => m.LicenseNo, new { @class = "form-control" })
            </div>
            <div class="col-md-6" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.Address)
                @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
            </div>
            <div class="col-md-6" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.Phone)
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
            </div>

            <hr />
            <h3>ข้อมูลรถ</h3>
            <div class="col-md-6" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.LicensePlate)
                @Html.TextBoxFor(m => m.LicensePlate, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.LicensePlate, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.Province)
                @Html.TextBoxFor(m => m.Province, new { @class = "form-control" })
            </div>
            <div class="col-md-6" style="margin-top:10px;margin-bottom:10px;">
                @Html.LabelFor(m => m.WeightKg)
                @Html.TextBoxFor(m => m.WeightKg, new { @class = "form-control" })
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="container">
            <input type="submit" class="btn btn-default" value="บันทึก" />
            @Html.ActionLink("ยกเลิก", "Truck_information", null, new { @class = "btn btn-default" })
        </div>
    </div>
}
