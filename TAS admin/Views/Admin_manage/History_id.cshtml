@model TAS_admin.Models.Shipment
@{
    ViewBag.Title = "History_id";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">

<h2>รายละเอียดงานขนส่ง: @Model.ShipmentNo</h2>
<br />

<div class="container">
    <p><b>สถานะ:</b> @Model.Status</p>
    <p><b>วันที่ส่ง:</b> @(Model.DeliveryDate.HasValue ? Model.DeliveryDate.Value.ToString("dd/MM/yyyy") : "-")</p>
    <p><b>คนขับ:</b> @(Model.Driver != null ? Model.Driver.FullName : "-") (@(Model.Driver != null ? Model.Driver.Phone : "-"))</p>
    <p><b>ทะเบียนรถ:</b> @(Model.Truck != null ? Model.Truck.LicensePlate : "-")</p>
</div>

<hr />
<h3>Delivery Orders</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Delivery No</th>
            <th>Order No</th>
            <th>DueDate</th>
            <th>Loading Station</th>
            <th>Destination</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var order in ViewBag.DeliveryOrders)
    {
        <tr>
            <td>@order.DeliveryNo</td>
            <td>@order.OrderNo</td>
            <td>@(order.DueDate.HasValue ? order.DueDate.Value.ToString("dd/MM/yyyy") : "-")</td>
            <td>@order.LoadingStation</td>
            <td>@order.Destination</td>
        </tr>
    }
    </tbody>
</table>

<p>@Html.ActionLink("&laquo; กลับไปหน้าประวัติ", "History", null, new { @class = "btn btn-default" })</p>
