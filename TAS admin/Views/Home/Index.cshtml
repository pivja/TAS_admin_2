@{
    ViewBag.Title = "Home Page";
}
<br />
<div class="jumbotron" style="padding-top:15px;padding-bottom:15px;">
    <h3 style="margin-top:0;">แผนที่ติดตามรถขนส่งทั้งหมด (แบบสด)</h3>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <div id="homeMap" style="width:100%; height:450px;"></div>
    <script>
        var homeMap = L.map('homeMap').setView([13.7563, 100.5018], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(homeMap);

        var homeMarkers = {};

        function refreshHomeLocations() {
            fetch('/Admin_manage/TruckLocations')
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    data.forEach(function (t) {
                        var popupText = t.licensePlate + (t.driverName ? ' - ' + t.driverName : '') +
                            '<br/>อัปเดตล่าสุด: ' + (t.updatedAt ? t.updatedAt : '-');
                        if (homeMarkers[t.truckId]) {
                            homeMarkers[t.truckId].setLatLng([t.lat, t.lng]).setPopupContent(popupText);
                        } else {
                            homeMarkers[t.truckId] = L.marker([t.lat, t.lng]).addTo(homeMap).bindPopup(popupText);
                        }
                    });
                });
        }

        refreshHomeLocations();
        setInterval(refreshHomeLocations, 15000);
    </script>
</div>

